{
  "name": "espolio-regina-brasil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:emulator": "vite build --mode emulator --outDir dist-emulator",
    "test": "node --test tests/unit/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-espolio-regina \"node --test tests/emulator/*.test.js\"",
    "test:browser": "npm run build:emulator && firebase emulators:exec --only auth,firestore,hosting --config firebase.emulator.json --project demo-espolio-regina \"node --test tests/browser/*.test.js\"",
    "seed": "node scripts/seed-tasks.mjs"
  },
  "dependencies": {
    "firebase": "13.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "15.35.0",
    "playwright-core": "^1.58.0",
    "vite": "^7.3.0"
  }
}
